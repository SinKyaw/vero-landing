---
// Site footer — shared across every page. White background (sits on the
// near-white page), so it uses the teal wordmark and dark text. Links are
// root-relative.
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="navbar-logo"><img src="/assets/logo-primary.png" alt="Vero logo" style="height:32px;width:auto;vertical-align:middle;" /></a>
      <p class="footer-tagline">Help Gen Z build lasting financial habits through gamification and AI.</p>
      <div class="download-buttons">
        <a href="https://apps.apple.com/th/app/vero/id6759962937" target="_blank" rel="noopener">
          <img src="/assets/appstore-download.png" alt="Download on the App Store" class="download-badge" />
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.suparat.verofinance" target="_blank" rel="noopener">
          <img src="/assets/google-play-download-cropped.png" alt="Get it on Google Play" class="download-badge" />
        </a>
      </div>
    </div>
    <div class="footer-links">
      <div class="footer-column">
        <span class="footer-column-title">Product</span>
        <a href="/#pricing">Pricing</a>
        <a href="https://apps.apple.com/th/app/vero/id6759962937" target="_blank" rel="noopener noreferrer">Download</a>
      </div>
      <div class="footer-column">
        <span class="footer-column-title">Company</span>
        <a href="/about-us">About Us</a>
        <a href="/blog">Blog</a>
      </div>
      <div class="footer-column">
        <span class="footer-column-title">Legal</span>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    © 2026 Vero. All rights reserved.
  </div>
</footer>
