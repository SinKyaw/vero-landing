---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="How It Works - Vero">
  <!-- ── How It Works Section ── -->
  <section id="how-it-works" class="section">
    <div class="how-it-works-header">
      <p class="section-label">How It Works</p>
      <h2 class="section-headline">How Vero Works</h2>
    </div>
    <div class="steps">
      <div class="step">
        <div class="step-number">1</div>
        <h3 class="step-title">Set Your Budget</h3>
        <p class="step-text">Create your plan your way, or let Vero guide you.</p>
      </div>
      <div class="step">
        <div class="step-number">2</div>
        <h3 class="step-title">Log by Chatting</h3>
        <p class="step-text">Simply type your expenses — no manual tracking needed.</p>
      </div>
      <div class="step">
        <div class="step-number">3</div>
        <h3 class="step-title">Take on Challenges</h3>
        <p class="step-text">Build better habits through small, consistent actions.</p>
      </div>
      <div class="step">
        <div class="step-number">4</div>
        <h3 class="step-title">Compete &amp; Stay Consistent</h3>
        <p class="step-text">Climb the leaderboard and stay accountable.</p>
      </div>
      <div class="step">
        <div class="step-number">5</div>
        <h3 class="step-title">Review Your Spending</h3>
        <p class="step-text">See where your money goes and improve your decisions.</p>
      </div>
      <div class="step">
        <div class="step-number">6</div>
        <h3 class="step-title">Earn Rewards</h3>
        <p class="step-text">Turn discipline into real-life perks.</p>
      </div>
    </div>
  </section>
</BaseLayout>
