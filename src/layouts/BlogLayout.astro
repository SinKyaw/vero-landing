---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <slot name="head" slot="head" />
  <slot />
</BaseLayout>

<!-- Blog styles (shared by the listing and single-post pages). Kept global to
     match the original blog markup exactly. -->
<style is:global>
  /* byline (author / read time / date row) */
  .blog-byline {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: #555;
    margin: 8px 0 24px;
  }
  .byline-author { font-weight: 600; color: #111; }
  .byline-dot { color: #999; }
  .byline-avatar {
    width: 28px;
    height: 28px;
    min-width: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  /* post body */
  #post-content p,
  #post-content li {
    line-height: 2;
    margin-bottom: 15px;
  }
  #post-content h1 { font-size: 2.25rem; font-weight: 700; margin-top: 32px; margin-bottom: 16px; }
  #post-content h2 { font-size: 1.75rem; font-weight: 700; margin-top: 28px; margin-bottom: 14px; }
  #post-content h3 { font-size: 1.4rem; font-weight: 700; margin-top: 24px; margin-bottom: 12px; }
  #post-content h4 { font-size: 1.15rem; font-weight: 600; margin-top: 20px; margin-bottom: 10px; }
  #post-content img { max-width: 100%; }

  /* listing cards — every card is the same fixed height (`--blog-card-h`), so
     the cover image is forced to crop (object-fit: cover) instead of dictating
     the card size. Long titles are clamped below so nothing overflows. */
  #blog-listing {
    --blog-card-h: 280px;
  }
  .blog-card {
    display: flex;
    align-items: stretch;
    height: var(--blog-card-h);
    margin-bottom: 16px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    overflow: hidden;
  }
  .blog-card-image {
    width: 50%;
    max-width: 50%;
    height: 100%;
    flex-shrink: 0;
    object-fit: cover;
    background: rgba(45, 223, 193, 0.1);
    display: block;
  }
  .blog-card-body {
    width: 50%;
    min-width: 0;
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .blog-card-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #2ddfc1;
  }
  .blog-card-title {
    font-family: 'Quicksand', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #111;
    line-height: 1.3;
    margin: 0;
    /* Clamp to 3 lines so a long title can't push past the fixed card height. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-card-date { font-family: 'Inter', sans-serif; font-size: 0.9rem; color: #666; }
  .blog-card-link {
    display: inline-block;
    margin-top: 8px;
    padding: 10px 20px;
    border: 1px solid #005149;
    border-radius: 20px;
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    color: #fff;
    background-color: #005149;
    text-decoration: none;
    width: fit-content;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .blog-card-link:hover { background-color: #003d36; border-color: #003d36; color: #fff; }
  .post-loading {
    padding: 48px 24px;
    text-align: center;
    color: #666;
    font-family: 'Inter', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    /* Stacked: image on top at a fixed height (uniform previews), body flows
       naturally below, so the card grows with its content instead of squeezing. */
    .blog-card { flex-direction: column; height: auto; }
    .blog-card-image { width: 100%; max-width: 100%; height: 200px; }
    .blog-card-body { width: 100%; padding: 24px; }
  }
</style>
